# Copy to a private file outside the repository. Replace placeholders locally.
CREW_CHIEF_BIND_HOST=<your-tailscale-ip>
CREW_CHIEF_BIND_PORT=18804
CREW_CHIEF_PUBLIC_URL=http://<your-tailscale-ip>:18804
CREW_CHIEF_CLIENT_TOKEN=<generated-by-setup-helper>
OPENCLAW_TARGET=http://127.0.0.1:18789
OPENCLAW_MODEL=openclaw/racebox-crew-chief
OPENCLAW_CONFIG=<path-to-your-openclaw-config>
CREW_CHIEF_STATE_DIRECTORY=<private-local-state-directory>
ALLOWED_CLIENT_CIDRS=127.0.0.0/8,100.64.0.0/10
MAX_BODY_BYTES=25165824
OPENCLAW_TIMEOUT_SECONDS=240
CREW_CHIEF_VISION_ENABLED=0
